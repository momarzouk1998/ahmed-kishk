generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TECHNICIAN
  BRANCH_STAFF
  WORKSHOP
}

enum InspectionStatus {
  SCHEDULED
  PENDING
  COMPLETED
  CANCELLED
}

enum RoomType {
  WINDOW
  BALCONY
}

enum InstallationType {
  CEILING_TRACK
  WALL_TRACK
  RODS
}

enum CeilingType {
  STANDARD
  HOLLOW_GYPSUM
  LIGHT_BOX
}

model User {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  password  String
  role      Role     @default(BRANCH_STAFF)
  branch    String   @default("الفرع الرئيسي")
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  address   String?
  // ملحوظة: `city` تُستخدم فعلياً كحقل "الفرع" (القوائم المنسدلة فى الواجهة
  // تعرض أسماء الفروع الأربعة وتحفظها هنا) — لا يوجد عمود city حقيقى منفصل،
  // ولا عمود branch مستقل، تفادياً لتكرار نفس المعنى بقيمة افتراضية خاطئة
  // للعملاء الحاليين. عزل الفرع لهذا الجدول يعتمد على `city`.
  city      String?
  balance   Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  InspectionRequest InspectionRequest[]
}

/// سند تحصيل واحد من عميل. كانت كل سندات كل العملاء قبل كده متخزنة كمصفوفة JSON
/// واحدة مشتركة فى SystemStore، وأي إضافة/تعديل/حذف كان بيبعت المصفوفة **كاملة**
/// فيستبدلها كاملة فى الداتابيز — لو مستخدمين اتنين ضافوا سند لعميلين مختلفين فى
/// نفس اللحظة تقريبًا، اللي يحفظ تاني كان بيمحي سند التاني نهائيًا بصمت. دلوقتى كل
/// سند صف مستقل حقيقي، فالإضافة INSERT مستقل مش استبدال قائمة كاملة.
model CustomerCollection {
  id           String   @id @default(cuid())
  date         String
  customerId   String
  customerName String
  phone        String
  branch       String   @default("الفرع الرئيسي")
  amount       Float    @default(0)
  method       String   @default("نقدي")
  treasury     String   @default("خزينة الفرع الرئيسي (سعد زغلول)")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model InspectionRequest {
  id           String    @id @default(cuid())
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  customerName String
  phone        String
  address      String
  branch       String    @default("الفرع الرئيسي")
  scheduledAt  String
  technician   String    @default("أحمد كشك")
  status       String    @default("تم رفع المقاسات")
  isLocked     Boolean   @default(false)
  notes        String?
  rooms        Json      @default("[]")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model QuotationOrder {
  id               String   @id @default(cuid())
  inspectionId     String
  customerName     String
  phone            String
  address          String
  branch           String   @default("الفرع الرئيسي")
  status           String   @default("بانتظار التسعير")
  totalAmount      Float    @default(0)
  discountAmount   Float?   @default(0)
  depositPaid      Float    @default(0)
  remainingAmount  Float    @default(0)
  paymentMethod    String?  @default("نقدي (كاش)")
  splitPayments    Json?
  treasury         String?
  date             String
  inspectionDate   String?
  deliveryDate     String?
  installationDate String?
  estimatorName    String   @default("أحمد كشك")
  rooms            Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PipelineOrder {
  id               String   @id @default(cuid())
  orderId          String
  customerName     String
  phone            String
  address          String
  branch           String   @default("الفرع الرئيسي")
  inspectionDate   String?
  deliveryDate     String?
  installationDate String?
  cutterName       String?
  tailorName       String?
  technicianName   String?
  status           String   @default("في المقص")
  localStatus      String?  @default("بانتظار القص")
  totalAmount      Float    @default(0)
  discountAmount   Float?   @default(0)
  depositPaid      Float    @default(0)
  remainingAmount  Float    @default(0)
  paymentMethod    String?  @default("نقدي (كاش)")
  splitPayments    Json?
  treasury         String?
  rooms            Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model InventoryItem {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  category         String
  unit             String   @default("متر")
  totalQuantity    Float    @default(0)
  reservedQuantity Float    @default(0)
  costPrice        Float    @default(0)
  sellPrice        Float    @default(0)
  branch           String   @default("الفرع الرئيسي")
  minAlert         Float    @default(20)
  supplier         String   @default("شركة النيل")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Supplier {
  id                 String   @id @default(cuid())
  name               String
  phone              String?
  address            String?
  branch             String   @default("الفرع الرئيسي")
  categoriesSupplied String[] @default([])
  totalPurchases     Float    @default(0)
  paidAmount         Float    @default(0)
  openingBalance     Float    @default(0)
  balance            Float    @default(0) // = balanceOwed (موجب: علينا للمورد)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // مطابقة فواتير الشراء/الشيكات/المدفوعات بالمورد بتعتمد على الاسم (مفيش
  // supplierId فى الجداول دي) — القيد ده يمنع إنشاء موردين بنفس الاسم فى نفس
  // الفرع أصلاً، فمنطق المطابقة بالاسم يفضل موثوق (اتأكد فعليًا إنه لا يوجد
  // تكرار حالي فى قاعدة البيانات قبل إضافة القيد).
  @@unique([name, branch])
}

model SupplierPayment {
  id           String   @id @default(cuid())
  date         String
  supplierId   String
  supplierName String
  amount       Float    @default(0)
  method       String   @default("نقدي")
  treasury     String   @default("الخزينة الرئيسية")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SupplierCheck {
  id           String   @id @default(cuid())
  checkNumber  String
  bankName     String
  supplierId   String
  supplierName String
  amount       Float    @default(0)
  issueDate    String
  dueDate      String
  status       String   @default("قيد الانتظار")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SalesInvoice {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique
  customerName    String
  phone           String
  branch          String   @default("الفرع الرئيسي")
  totalAmount     Float    @default(0)
  paidAmount      Float    @default(0)
  remainingAmount Float    @default(0)
  paymentType     String   @default("نقدي")
  date            String
  items           Json     @default("[]")
  notes           String?
  // #FIX: كانت الحقول دي بتتبعت من شاشة البيع أونلاين (fabric-sales/new) لكن
  // الـ API كان بيتجاهلها تمامًا — تتحفظ فعليًا فى الفاتورة نفسها دلوقتى.
  isOnlineOrder   Boolean  @default(false)
  shippingFee     Float    @default(0)
  shippingCompany String?
  trackingNumber  String?
  shippingAddress String?
  receiverPhone   String?
  orderSource     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PurchaseInvoice {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique
  supplierName    String
  supplierPhone   String?
  branch          String   @default("الفرع الرئيسي")
  subtotal        Float    @default(0)
  discountAmount  Float    @default(0)
  totalAmount     Float    @default(0)
  paidAmount      Float    @default(0)
  remainingAmount Float    @default(0)
  paymentMethod   String   @default("نقدي (كاش)")
  status          String   @default("آجل / غير مسدد")
  date            String
  items           Json     @default("[]")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SalesReturn {
  id            String   @id @default(cuid())
  returnNumber  String   @unique
  date          String
  invoiceNumber String
  customerName  String
  customerPhone String?
  branch        String   @default("الفرع الرئيسي")
  reason        String?
  itemsDetail   String?
  refundAmount  Float    @default(0)
  refundMethod  String   @default("نقدي")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PurchaseReturn {
  id            String   @id @default(cuid())
  returnNumber  String   @unique
  date          String
  invoiceNumber String
  supplierName  String
  supplierPhone String?
  branch        String   @default("الفرع الرئيسي")
  reason        String?
  itemsDetail   String?
  refundAmount  Float    @default(0)
  refundMethod  String   @default("نقدي (كاش)")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SystemStore {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model BranchCategory {
  id        String   @id @default(cuid())
  name      String
  branch    String   @default("الفرع الرئيسي")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, branch])
}

model Shift {
  id                   String    @id @default(cuid())
  branch               String    @default("الفرع الرئيسي")
  shiftType            String    @default("صباحي")
  employeeId           String
  employeeName         String
  startTime            String
  endTime              String?
  status               String    @default("OPEN")
  openingDrawerBalance Float     @default(0)
  cashSales            Float     @default(0)
  instapaySales        Float     @default(0)
  vodafoneSales        Float     @default(0)
  visaSales            Float     @default(0)
  totalSales           Float     @default(0)
  expensesPaid         Float     @default(0)
  advancesPaid         Float     @default(0)
  expectedCashInDrawer Float     @default(0)
  actualClosingCash    Float?
  cashDiscrepancy      Float?
  discrepancyReason    String?
  handoverDestination  String?
  handoverReceiverName String?
  closingNotes         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

/// مصروفات كل فرع (إيجار، كهرباء، صيانة، مواصلات...) — بتتخصم من خزينة الفرع
/// فى حساب الأرصدة (reports/page.tsx)، ومعزولة بالفرع زي باقي الجداول.
model Expense {
  id            String   @id @default(cuid())
  date          String
  branch        String   @default("الفرع الرئيسي")
  category      String   @default("أخرى")
  description   String   @default("")
  amount        Float    @default(0)
  paymentMethod String   @default("نقدي")
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// شؤون الموظفين والرواتب — كانت الأربعة موديولات دي (الموظفين، الحضور، السلف،
// تقفيل الرواتب) متخزنة بالكامل فى localStorage + نسخة احتياطية كـ JSON blob
// واحد فى SystemStore لكل موديول (نفس فئة المشكلة اللي كانت فى CustomerCollection
// قبل ما تتحول لجدول حقيقي) — أي إضافة/تعديل كانت تستبدل المصفوفة كاملة. دلوقتى
// كل سجل صف مستقل حقيقي.
// ─────────────────────────────────────────────────────────────────────────

model Employee {
  id            String   @id @default(cuid())
  name          String
  branch        String   @default("الفرع الرئيسي")
  dailyWage     Float    @default(0)
  monthlySalary Float?
  payType       String   @default("أسبوعي")
  workStartTime String   @default("11:00 AM")
  workEndTime   String   @default("11:30 PM")
  phone         String?
  role          String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AttendanceRecord {
  id            String   @id @default(cuid())
  date          String
  employeeId    String
  employeeName  String
  branch        String   @default("الفرع الرئيسي")
  status        String
  checkInTime   String?
  checkOutTime  String?
  delayMinutes  Float?
  notes         String?
  recordedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EmployeeAdvance {
  id                 String   @id @default(cuid())
  date               String
  employeeId         String
  employeeName       String
  branch             String   @default("الفرع الرئيسي")
  type               String
  amount             Float    @default(0)
  reason             String?
  treasuryDeducted   Boolean  @default(true)
  settledInPayrollId String?
  recordedBy         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PayrollSettlement {
  id               String   @id @default(cuid())
  settlementDate   String
  weekStartDate    String
  weekEndDate      String
  branch           String   @default("الفرع الرئيسي")
  employeeId       String
  employeeName     String
  dailyWage        Float    @default(0)
  daysAttended     Float    @default(0)
  baseSalaryEarned Float    @default(0)
  totalBonuses     Float    @default(0)
  totalDeductions  Float    @default(0)
  totalAdvances    Float    @default(0)
  netPayout        Float    @default(0)
  isPaid           Boolean  @default(false)
  paidAt           String?
  paidFromTreasury String?
  notes            String?
  payType          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}


