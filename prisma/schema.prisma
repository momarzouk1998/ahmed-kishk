generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TECHNICIAN
  BRANCH_STAFF
  WORKSHOP
}

enum InspectionStatus {
  SCHEDULED
  PENDING
  COMPLETED
  CANCELLED
}

enum RoomType {
  WINDOW
  BALCONY
}

enum InstallationType {
  CEILING_TRACK
  WALL_TRACK
  RODS
}

enum CeilingType {
  STANDARD
  HOLLOW_GYPSUM
  LIGHT_BOX
}

model User {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  password  String
  role      Role     @default(BRANCH_STAFF)
  branch    String   @default("الفرع الرئيسي")
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  address   String?
  // ملحوظة: `city` تُستخدم فعلياً كحقل "الفرع" (القوائم المنسدلة فى الواجهة
  // تعرض أسماء الفروع الأربعة وتحفظها هنا) — لا يوجد عمود city حقيقى منفصل،
  // ولا عمود branch مستقل، تفادياً لتكرار نفس المعنى بقيمة افتراضية خاطئة
  // للعملاء الحاليين. عزل الفرع لهذا الجدول يعتمد على `city`.
  city      String?
  balance   Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  InspectionRequest InspectionRequest[]
}

model InspectionRequest {
  id           String    @id @default(cuid())
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  customerName String
  phone        String
  address      String
  branch       String    @default("الفرع الرئيسي")
  scheduledAt  String
  technician   String    @default("أحمد كشك")
  status       String    @default("تم رفع المقاسات")
  isLocked     Boolean   @default(false)
  notes        String?
  rooms        Json      @default("[]")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model QuotationOrder {
  id              String   @id @default(cuid())
  inspectionId    String
  customerName    String
  phone           String
  address         String
  branch          String   @default("الفرع الرئيسي")
  status          String   @default("بانتظار التسعير")
  totalAmount     Float    @default(0)
  depositPaid     Float    @default(0)
  remainingAmount Float    @default(0)
  date            String
  deliveryDate    String?
  estimatorName   String   @default("أحمد كشك")
  rooms           Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PipelineOrder {
  id              String   @id @default(cuid())
  orderId         String
  customerName    String
  phone           String
  address         String
  branch          String   @default("الفرع الرئيسي")
  deliveryDate    String?
  cutterName      String?
  tailorName      String?
  technicianName  String?
  status          String   @default("في المقص")
  localStatus     String?  @default("بانتظار القص")
  totalAmount     Float    @default(0)
  depositPaid     Float    @default(0)
  remainingAmount Float    @default(0)
  rooms           Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model InventoryItem {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  category         String
  unit             String   @default("متر")
  totalQuantity    Float    @default(0)
  reservedQuantity Float    @default(0)
  costPrice        Float    @default(0)
  sellPrice        Float    @default(0)
  branch           String   @default("الفرع الرئيسي")
  minAlert         Float    @default(20)
  supplier         String   @default("شركة النيل")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Supplier {
  id                 String   @id @default(cuid())
  name               String
  phone              String?
  address            String?
  branch             String   @default("الفرع الرئيسي")
  categoriesSupplied String[] @default([])
  totalPurchases     Float    @default(0)
  paidAmount         Float    @default(0)
  openingBalance     Float    @default(0)
  balance            Float    @default(0) // = balanceOwed (موجب: علينا للمورد)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SupplierPayment {
  id           String   @id @default(cuid())
  date         String
  supplierId   String
  supplierName String
  amount       Float    @default(0)
  method       String   @default("نقدي")
  treasury     String   @default("الخزينة الرئيسية")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SupplierCheck {
  id           String   @id @default(cuid())
  checkNumber  String
  bankName     String
  supplierId   String
  supplierName String
  amount       Float    @default(0)
  issueDate    String
  dueDate      String
  status       String   @default("قيد الانتظار")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SalesInvoice {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique
  customerName    String
  phone           String
  branch          String   @default("الفرع الرئيسي")
  totalAmount     Float    @default(0)
  paidAmount      Float    @default(0)
  remainingAmount Float    @default(0)
  paymentType     String   @default("نقدي")
  date            String
  items           Json     @default("[]")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PurchaseInvoice {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique
  supplierName    String
  supplierPhone   String?
  branch          String   @default("الفرع الرئيسي")
  subtotal        Float    @default(0)
  discountAmount  Float    @default(0)
  totalAmount     Float    @default(0)
  paidAmount      Float    @default(0)
  remainingAmount Float    @default(0)
  paymentMethod   String   @default("نقدي (كاش)")
  status          String   @default("آجل / غير مسدد")
  date            String
  items           Json     @default("[]")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SystemStore {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}


