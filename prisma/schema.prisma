generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TECHNICIAN
  BRANCH_STAFF
  WORKSHOP
}

enum InspectionStatus {
  SCHEDULED
  PENDING
  COMPLETED
  CANCELLED
}

enum RoomType {
  WINDOW
  BALCONY
}

enum InstallationType {
  CEILING_TRACK
  WALL_TRACK
  RODS
}

enum CeilingType {
  STANDARD
  HOLLOW_GYPSUM
  LIGHT_BOX
}

model User {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  password  String
  role      Role     @default(BRANCH_STAFF)
  branch    String   @default("الفرع الرئيسي")
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  InspectionRequest InspectionRequest[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  address   String?
  city      String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  InspectionRequest InspectionRequest[]
  Order             Order[]
  FabricSale        FabricSale[]
}

model InspectionRequest {
  id           String           @id @default(cuid())
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id])
  status       InspectionStatus @default(PENDING)
  stage        String           @default("معاينة")
  address      String
  scheduledAt  DateTime?
  installAt    DateTime?
  assignedToId String?
  assignedTo   User?            @relation(fields: [assignedToId], references: [id])
  totalCost    Float            @default(0)
  branch       String           @default("الفرع الرئيسي")
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  rooms RoomMeasurement[]
}

model RoomMeasurement {
  id                  String            @id @default(cuid())
  inspectionRequestId String
  inspectionRequest   InspectionRequest @relation(fields: [inspectionRequestId], references: [id], onDelete: Cascade)
  roomName            String
  roomType            RoomType          @default(WINDOW)
  widthCm             Float
  heightCm            Float
  sides               Int               @default(2)
  extraHeightCm       Float?            @default(0)
  installationType    InstallationType  @default(CEILING_TRACK)
  ceilingType         CeilingType       @default(STANDARD)
  fabricMeters        Float?            @default(0)
  avgPricePerMeter    Float?            @default(0)
  estimatedCost       Float?            @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  fabrics FabricDetail[]
}

model FabricDetail {
  id                String          @id @default(cuid())
  roomMeasurementId String
  roomMeasurement   RoomMeasurement @relation(fields: [roomMeasurementId], references: [id], onDelete: Cascade)
  layerName         String
  fabricCode        String?
  hasPleatedTape    Boolean         @default(false)
  hasEyeletRings    Boolean         @default(false)
  notes             String?
}

model InventoryItem {
  id            String   @id @default(cuid())
  name          String
  category      String
  code          String   @unique
  quantityMeters Float   @default(0)
  costPerMeter  Float    @default(0)
  pricePerMeter Float    @default(0)
  branch        String   @default("الفرع الرئيسي")
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  balance   Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory InventoryItem[]
}

model FabricSale {
  id         String   @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  branch     String   @default("الفرع الرئيسي")
  totalAmount Float   @default(0)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items FabricSaleItem[]
}

model FabricSaleItem {
  id            String     @id @default(cuid())
  saleId        String
  sale          FabricSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  inventoryItemId String
  fabricName    String
  meters        Float
  pricePerMeter Float
  totalPrice    Float
}

model Order {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  totalAmount Float
  stage       String   @default("اختيار قماش")
  branch      String   @default("الفرع الرئيسي")
  technician  String?
  installAt   DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
